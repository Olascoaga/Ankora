{
  "name": "@ankora/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 1420 --configLoader runner",
    "build:web": "tsc -b && vite build --configLoader runner",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc -b --pretty false",
    "dev:tauri-prereq": "powershell -ExecutionPolicy Bypass -File ../../scripts/dev.ps1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:installer": "powershell -ExecutionPolicy Bypass -File ../../scripts/build_windows_installer.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "molstar": "^5.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
