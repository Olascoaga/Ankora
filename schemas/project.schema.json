{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ankora.local/schemas/project.schema.json",
  "title": "Ankora project catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["active_project_id", "projects"],
  "properties": {
    "active_project_id": { "$ref": "#/$defs/projectId" },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "name", "registered_at", "migrated_legacy"],
      "properties": {
        "project_id": { "$ref": "#/$defs/projectId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "registered_at": { "type": "string", "format": "date-time" },
        "migrated_legacy": { "type": "boolean" }
      }
    }
  }
}
